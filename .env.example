# Procura environment reference.
#
# Copy to .env.local and fill in. AUTH_SECRET is required in production; in
# development NextAuth will issue a warning but still start.
#
# Generate a secret locally with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# Required in production. At least 32 random bytes.
AUTH_SECRET=

# The canonical URL of this deployment, with no trailing slash.
AUTH_URL=https://procura.example.com
AUTH_TRUST_HOST=true

# Optional. The LLM bridge used by the nine agents. Without a key every agent
# runs on its deterministic rule engine and the pipeline is still complete.
PROCURA_LLM_API_KEY=
PROCURA_LLM_BASE_URL=https://api.openai.com/v1
PROCURA_LLM_MODEL=gpt-4o-mini

# Optional. Absolute or relative path to the SQLite database file.
# Defaults to ./data/procura.db
PROCURA_DB_PATH=./data/procura.db

# Optional. Directory where request attachments are written.
# Files are stored under <dir>/<requestId>/<generated-name>, never under a path
# taken from the uploaded file name. Defaults to ./data/uploads
PROCURA_UPLOAD_DIR=./data/uploads